  "scripts": {
    "setup": "bash infra/setup.sh",
    "rooms": "node simulator/house.js",
    "nodered": "node nodered/buildflow.js && node-red --userDir nodered flows.json",
    "dashboard": "node dashboard/server.js",
    "loadtest": "node loadtest/loadtest.js --steps=25,50,100 --step-secs=120 --every=1000 --workers=4",
