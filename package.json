    "report": "node docs/build_report.js",
    "teardown": "bash infra/teardown.sh"
  },
  "dependencies": {
    "@aws-sdk/client-dynamodb": "^3.1146.0",
    "@aws-sdk/lib-dynamodb": "^3.1146.0",
